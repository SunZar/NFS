<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.NFS.ToolbarButton" parent="android:Widget.ImageButton">
        <item name="android:layout_width">@dimen/toolbar_size</item>
        <item name="android:layout_height">@dimen/toolbar_size</item>
        <item name="android:background">@drawable/background_toolbar_button_ripple</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Widget.NFS.BlockHeading" parent="">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Title</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="Widget.NFS.ToolbarTitle" parent="Widget.NFS.BlockHeading">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/toolbar_size</item>
        <item name="android:layout_marginEnd">@dimen/toolbar_size</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/content_primary</item>
    </style>

    <style name="Widget.NFS.Workspace" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_marginTop">@dimen/workspace_gap</item>
        <item name="android:layout_marginBottom">@dimen/workspace_gap</item>
        <item name="android:paddingHorizontal">@dimen/workspace_gap</item>
    </style>

    <style name="Widget.NFS.WorkspaceHeading" parent="Widget.NFS.BlockHeading">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/workspace_heading_inset</item>
        <item name="android:layout_marginTop">@dimen/workspace_gap</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.NFS.HeroBanner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.NFS.HeroArrow" parent="">
        <item name="android:layout_width">160dp</item>
        <item name="android:layout_height">160dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/round_arrow_upward_24</item>
    </style>

    <style name="Widget.NFS.HeroPrompt" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-16dp</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="Widget.NFS.HeroHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/content_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.NFS.TextPanel" parent="">
        <item name="android:layout_margin">@dimen/workspace_gap</item>
        <item name="android:background">@drawable/background_inner_floating_island_corners_4dp</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.NFS.TextPanelContent" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">@dimen/text_panel_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/text_panel_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/text_panel_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/text_panel_padding_vertical</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textColorHighlight">@color/text_selection</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.NFS.TextPanelInput" parent="Widget.NFS.TextPanelContent">
        <item name="android:background">@null</item>
        <item name="android:textColorHint">@color/content_secondary</item>
    </style>

    <style name="Widget.NFS.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/action_content</item>
        <item name="android:textSize">18sp</item>
        <item name="backgroundTint">@color/action_button_background</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.NFS.ActionButton" parent="Widget.NFS.Button">
        <item name="android:shadowColor">@color/action_text_shadow</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">1.5</item>
    </style>

    <style name="Widget.NFS.ActionButton.Compact" parent="Widget.NFS.ActionButton">
        <item name="android:paddingHorizontal">6dp</item>
    </style>

    <style name="Widget.NFS.TagCountButton" parent="Widget.NFS.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">7dp</item>
        <item name="android:insetBottom">7dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/tag_count_text</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/tag_count_background</item>
        <item name="cornerRadius">100dp</item>
        <item name="icon">@drawable/expand_more_24</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/tag_count_text</item>
        <item name="rippleColor">@color/tag_count_highlight</item>
    </style>

    <style name="Widget.NFS.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/background_popup_menu</item>
    </style>

    <style name="ThemeOverlay.NFS.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.NFS</item>
        <item name="android:dialogCornerRadius">12dp</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.NFS.Title</item>
    </style>

    <style name="MaterialAlertDialog.NFS" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.NFS.AlertDialog</item>
    </style>

    <style name="MaterialAlertDialog.NFS.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.NFS.AlertDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.NFS.ValidationField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/field_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/text_panel_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/text_panel_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/text_panel_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/text_panel_corner_radius</item>
        <item name="boxStrokeColor">@color/field_outline_states</item>
        <item name="cursorColor">@color/accent</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="errorIconDrawable">@null</item>
    </style>
</resources>
