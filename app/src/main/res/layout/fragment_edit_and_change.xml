<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workspace_floating_island"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/background_floating_island_corners_12dp">

    <ScrollView
        android:id="@+id/workspace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/workspace_gap">

            <TextView
                android:id="@+id/coded_information_label"
                style="@style/Widget.NFS.WorkspaceHeading"
                android:layout_width="match_parent"
                android:labelFor="@id/coded_information_edit_text"
                android:text="Шифруемая информация" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/coded_information_input"
                style="@style/Widget.NFS.ValidationField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/workspace_gap"
                android:layout_marginTop="@dimen/workspace_gap"
                android:layout_weight="1">

                <!-- Keep the intrinsic height small so fillViewport can give the editor the remaining space. -->
                <ru.archzar.nearfieldstorage.SensitiveEditText
                    android:id="@+id/coded_information_edit_text"
                    style="@style/Widget.NFS.TextPanelInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="top|start"
                    android:hint="@string/vault_text_hint"
                    android:imeOptions="flagNoPersonalizedLearning|flagNoExtractUi"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:maxHeight="108dp"
                    android:minHeight="108dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/editor_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/workspace_heading_inset"
                android:layout_marginBottom="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/content_secondary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dividing_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/workspace_heading_inset"
                android:layout_marginVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_count"
                    style="@style/Widget.NFS.TagCountButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    tools:text="Метки: 1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/decryption_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/decryption_key_label"
                    style="@style/Widget.NFS.WorkspaceHeading"
                    android:layout_width="match_parent"
                    android:layout_marginTop="0dp"
                    android:labelFor="@id/decryption_key_edit_text"
                    android:text="@string/master_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/master_password_input"
                    style="@style/Widget.NFS.ValidationField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/workspace_gap"
                    android:layout_marginTop="@dimen/workspace_gap">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/decryption_key_edit_text"
                        style="@style/Widget.NFS.TextPanelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical|start"
                        android:hint="@string/master_password_hint"
                        android:imeOptions="actionDone|flagNoPersonalizedLearning|flagNoExtractUi"
                        android:inputType="textPassword"
                        android:minHeight="52dp"
                        android:singleLine="false" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
