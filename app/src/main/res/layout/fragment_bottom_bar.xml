<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bar_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/or_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/workspace_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/or"
                android:textColor="@color/content_primary"
                android:textSize="14sp" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                style="@style/Widget.NFS.ActionButton.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/secondary_action" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary_action"
                style="@style/Widget.NFS.ActionButton.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/workspace_gap"
                android:visibility="gone"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/primary_action"
                app:layout_constraintEnd_toEndOf="parent" />
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/crypto_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/action_content"
                app:indicatorInset="0dp"
                app:indicatorSize="24dp"
                app:trackThickness="3dp"
                app:layout_constraintTop_toTopOf="@id/primary_action"
                app:layout_constraintBottom_toBottomOf="@id/primary_action"
                app:layout_constraintStart_toStartOf="@id/primary_action"
                app:layout_constraintEnd_toEndOf="@id/primary_action" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
