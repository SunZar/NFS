<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workspace_floating_island"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/background_floating_island_corners_12dp">

    <TextView
        android:id="@+id/label"
        style="@style/Widget.NFS.WorkspaceHeading"
        android:layout_width="0dp"
        android:text="Запись информации"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/workspace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/workspace_gap"
        app:layout_constraintTop_toBottomOf="@id/label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/banner"
            style="@style/Widget.NFS.HeroBanner">

            <ImageView
                android:id="@+id/arrow"
                style="@style/Widget.NFS.HeroArrow" />

            <TextView
                android:id="@+id/attach_nfc"
                style="@style/Widget.NFS.HeroPrompt"
                android:text="@string/nfc_prompt" />

            <TextView
                android:id="@+id/attach_hint"
                style="@style/Widget.NFS.HeroHint"
                tools:text="Держите до подтверждения" />

            <TextView
                android:id="@+id/capacity_error"
                style="@style/Widget.NFS.HeroHint"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/error"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
