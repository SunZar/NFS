<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/screen_background"
    android:id="@+id/coordinator">

    <View
        android:id="@+id/shadow_of_top_floating_island"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/top_floating_island"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/background_shadow_of_top_island_gradient"
        android:layout_marginBottom="-16dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/workspace_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="8dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_floating_island"
        app:layout_constraintBottom_toTopOf="@id/bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/workspace_floating_island"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="0dp"
            android:background="@drawable/background_floating_island_corners_12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Расшифрованная информация"
                android:textSize="16sp"
                style="@style/Widget.NFS.BlockHeading"
                android:textColor="@color/accent"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <FrameLayout
                android:id="@+id/copy_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="8dp"
                android:background="@drawable/background_inner_floating_island_corners_4dp"
                app:layout_constraintTop_toBottomOf="@id/label"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ScrollView
                    android:id="@+id/workspace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ru.archzar.nearfieldstorage.SensitiveTextView
                        android:id="@+id/decoded_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:textIsSelectable="false"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginVertical="4dp"

                        android:textSize="16sp"
                        android:textColor="@color/content_primary"/>

                </ScrollView>

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.NFS.ActionButton.Compact"
            android:id="@+id/copy_mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/copy_mode" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.NFS.ActionButton.Compact"
            android:id="@+id/edit_and_change"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Изменить и сохранить"
            android:layout_marginStart="8dp" />

    </LinearLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_floating_island"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/background_floating_island_corners_12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            style="@style/Widget.NFS.ToolbarButton"
            android:id="@+id/back"
            android:src="@drawable/round_arrow_back_24"
            android:contentDescription="@string/back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/title"
            style="@style/Widget.NFS.ToolbarTitle"
            android:text="Данные"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            style="@style/Widget.NFS.ToolbarButton"
            android:id="@+id/menu"
            android:src="@drawable/round_more_vert_24"
            android:contentDescription="@string/more_options"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
