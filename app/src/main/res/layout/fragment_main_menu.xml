<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/screen_background"
    android:id="@+id/coordinator">

    <View
        android:id="@+id/shadow_of_top_floating_island"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/top_floating_island"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/background_shadow_of_top_island_gradient"
        android:layout_marginBottom="-16dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/workspace_layout"
        style="@style/Widget.NFS.Workspace"
        app:layout_constraintTop_toBottomOf="@id/top_floating_island"
        app:layout_constraintBottom_toTopOf="@id/bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/workspace_floating_island"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="0dp"
            android:background="@drawable/background_floating_island_corners_12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/label"
                style="@style/Widget.NFS.WorkspaceHeading"
                android:layout_width="0dp"
                android:text="Главный экран"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ScrollView
                android:id="@+id/workspace"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="@dimen/workspace_gap"
                app:layout_constraintTop_toBottomOf="@id/label"
                app:layout_constraintBottom_toTopOf="@id/app_version"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/banner"
                    style="@style/Widget.NFS.HeroBanner">

                    <ImageView
                        android:id="@+id/arrow"
                        style="@style/Widget.NFS.HeroArrow" />

                    <TextView
                        android:id="@+id/attach_nfc"
                        style="@style/Widget.NFS.HeroPrompt"
                        android:text="@string/nfc_prompt" />

                    <TextView
                        android:id="@+id/attach_hint"
                        style="@style/Widget.NFS.HeroHint"
                        android:text="@string/read_nfc_hint" />

                </LinearLayout>

            </ScrollView>

            <TextView
                android:id="@+id/app_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/workspace_gap"
                android:layout_marginBottom="@dimen/workspace_gap"
                android:gravity="center"
                android:textColor="@color/content_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Near Field Storage, ver: x.x.x" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/workspace_gap"
        android:layout_marginBottom="@dimen/workspace_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.NFS.ActionButton"
            android:id="@+id/save_and_rewrite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Записать данные"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_floating_island"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_size"
        android:layout_margin="8dp"
        android:background="@drawable/background_floating_island_corners_12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ru.archzar.nearfieldstorage.RoundedToolbarButton
            style="@style/Widget.NFS.ToolbarButton"
            android:id="@+id/menu"
            android:src="@drawable/round_more_vert_24"
            android:contentDescription="@string/more_options"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/title"
            style="@style/Widget.NFS.ToolbarTitle"
            android:text="NFS"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ru.archzar.nearfieldstorage.RoundedToolbarButton
            style="@style/Widget.NFS.ToolbarButton"
            android:id="@+id/info"
            android:src="@drawable/round_info_outline_24"
            android:contentDescription="@string/help_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
